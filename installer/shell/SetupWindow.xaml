<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="安装 DUN" Width="752" Height="624" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" FontFamily="Microsoft YaHei UI, Segoe UI">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="#69717D"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="16,10"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" CornerRadius="12" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="2">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#8CABC8"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- CheckBox drawn as a switch -->
    <Style TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Track" Width="40" Height="24" CornerRadius="12" Background="#DCE1E8" Padding="3">
              <Ellipse x:Name="Knob" Width="18" Height="18" Fill="White" HorizontalAlignment="Left">
                <Ellipse.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.18"/></Ellipse.Effect>
              </Ellipse>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="#25282D"/>
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Margin="16" CornerRadius="24" Background="White" BorderBrush="#E9EDF2" BorderThickness="1">
    <Border.Effect><DropShadowEffect BlurRadius="25" ShadowDepth="5" Opacity="0.14" Color="#273449"/></Border.Effect>
    <Viewbox Stretch="Uniform">
      <Grid Width="720" Height="592" Background="Transparent">
        <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="88"/></Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Margin="30,0,20,0" Background="Transparent">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="DUN" FontFamily="Segoe UI" FontWeight="Bold" FontSize="19" Foreground="#25282D"/>
            <TextBlock Text="剪贴板晾衣绳" FontSize="11" Foreground="#9CA5B2" VerticalAlignment="Center" Margin="10,3,0,0"/>
          </StackPanel>
          <Button x:Name="CloseButton" HorizontalAlignment="Right" Width="34" Height="34" Padding="0">
            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="#9099A7" StrokeThickness="1.3" Width="10" Height="10"/>
          </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="44,0">
          <Grid.RowDefinitions><RowDefinition Height="172"/><RowDefinition Height="92"/><RowDefinition Height="*"/></Grid.RowDefinitions>

          <!-- A clothesline with three clips: a note, a photo and a link -->
          <Canvas Width="320" Height="160" HorizontalAlignment="Center">
            <Ellipse Canvas.Left="10" Canvas.Top="36" Width="300" Height="130">
              <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#F1F5F9" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
            </Ellipse>
            <Path Data="M 0,30 Q 160,58 320,30" Stroke="#CDBA9C" StrokeThickness="2"/>
            <Border Canvas.Left="38" Canvas.Top="38" Width="86" Height="98" CornerRadius="11" BorderBrush="#F0DFAE" BorderThickness="1" RenderTransformOrigin="0.5,0" Padding="13,14">
              <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFFBEB" Offset="0"/><GradientStop Color="#FEF0BE" Offset="1"/></LinearGradientBrush></Border.Background>
              <Border.RenderTransform><RotateTransform Angle="-8"/></Border.RenderTransform>
              <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="6" Opacity="0.10" Color="#6D7C91"/></Border.Effect>
              <StackPanel>
                <Border Height="6" Width="48" Background="#C9B27A" CornerRadius="3" HorizontalAlignment="Left"/>
                <Border Height="4" Width="58" Background="#E8D9A8" CornerRadius="2" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                <Border Height="4" Width="52" Background="#E8D9A8" CornerRadius="2" HorizontalAlignment="Left" Margin="0,7,0,0"/>
                <Border Height="4" Width="36" Background="#E8D9A8" CornerRadius="2" HorizontalAlignment="Left" Margin="0,7,0,0"/>
              </StackPanel>
            </Border>
            <Border Canvas.Left="128" Canvas.Top="45" Width="108" Height="86" CornerRadius="11" Background="White" BorderBrush="#E0E7EF" BorderThickness="1" Padding="4" RenderTransformOrigin="0.5,0">
              <Border.RenderTransform><RotateTransform Angle="2"/></Border.RenderTransform>
              <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="8" Opacity="0.12" Color="#6D7C91"/></Border.Effect>
              <Border CornerRadius="8" ClipToBounds="True">
                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#93B4F8" Offset="0"/><GradientStop Color="#A9A2F4" Offset="1"/></LinearGradientBrush></Border.Background>
                <Grid>
                  <Ellipse Width="16" Height="16" Fill="#F7F1DC" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,16,0"/>
                  <Path Data="M 0,76 L 30,44 L 52,64 L 76,38 L 100,76 Z" Fill="#5C6FC7" Stretch="Fill" VerticalAlignment="Bottom" Height="40"/>
                </Grid>
              </Border>
            </Border>
            <Border Canvas.Left="242" Canvas.Top="38" Width="76" Height="60" CornerRadius="11" Background="White" BorderBrush="#E0E7EF" BorderThickness="1" Padding="12,12" RenderTransformOrigin="0.5,0">
              <Border.RenderTransform><RotateTransform Angle="9"/></Border.RenderTransform>
              <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="6" Opacity="0.10" Color="#6D7C91"/></Border.Effect>
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="9" Height="9" Fill="#BFD3F3"/>
                  <Border Height="6" Width="30" Background="#7F96B1" CornerRadius="3" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Border Height="4" Width="44" Background="#E6EBF1" CornerRadius="2" HorizontalAlignment="Left" Margin="0,10,0,0"/>
              </StackPanel>
            </Border>
            <Border Canvas.Left="77" Canvas.Top="29" Width="9" Height="20" CornerRadius="3" BorderBrush="#33000000" BorderThickness="0.8">
              <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#EED9B6" Offset="0"/><GradientStop Color="#A98255" Offset="1"/></LinearGradientBrush></Border.Background>
            </Border>
            <Border Canvas.Left="177" Canvas.Top="36" Width="9" Height="20" CornerRadius="3" BorderBrush="#33000000" BorderThickness="0.8">
              <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FC8A8A" Offset="0"/><GradientStop Color="#B91C1C" Offset="1"/></LinearGradientBrush></Border.Background>
            </Border>
            <Border Canvas.Left="276" Canvas.Top="29" Width="9" Height="20" CornerRadius="3" BorderBrush="#33000000" BorderThickness="0.8">
              <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#EED9B6" Offset="0"/><GradientStop Color="#A98255" Offset="1"/></LinearGradientBrush></Border.Background>
            </Border>
          </Canvas>

          <StackPanel Grid.Row="1" HorizontalAlignment="Center">
            <TextBlock x:Name="Headline" Text="复制过的，都晾在这根绳上。" FontSize="28" FontWeight="DemiBold" Foreground="#25282D" HorizontalAlignment="Center"/>
            <TextBlock x:Name="Subtitle" Text="文字、链接、图片、文件，随时找回，一键再用。" FontSize="12" Foreground="#929CAB" Margin="0,14,0,0" HorizontalAlignment="Center"/>
          </StackPanel>

          <Grid Grid.Row="2">
            <StackPanel x:Name="ReadyPanel">
              <Border CornerRadius="13" Background="#F8F9FB" BorderBrush="#EBEEF3" BorderThickness="1" Padding="17,12">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="安装位置" Foreground="#929CAA" FontSize="10"/>
                    <TextBlock x:Name="DirectoryLabel" FontSize="11" Foreground="#5B6675" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <Button x:Name="ChangeDirectoryButton" Grid.Column="1" Content="更改" Padding="11,7" VerticalAlignment="Center" FontSize="11"/>
                </Grid>
              </Border>
              <Grid Margin="4,16,4,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="开机自动启动" FontSize="12" Foreground="#25282D"/>
                  <TextBlock Text="登录后在托盘里待命" FontSize="10" Foreground="#9CA5B2" Margin="0,4,0,0"/>
                </StackPanel>
                <CheckBox x:Name="AutostartBox" Grid.Column="1" IsChecked="True" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                  <TextBlock Text="桌面快捷方式" FontSize="12" Foreground="#25282D"/>
                  <TextBlock Text="在桌面放一个 DUN 图标" FontSize="10" Foreground="#9CA5B2" Margin="0,4,0,0"/>
                </StackPanel>
                <CheckBox x:Name="DesktopBox" Grid.Column="4" IsChecked="False" VerticalAlignment="Center"/>
              </Grid>
              <TextBlock x:Name="ExistingLabel" Text="无需管理员权限 · 不联网 · 数据只保存在本机" FontSize="11" Foreground="#8D98A6" Margin="4,16,0,0"/>
            </StackPanel>

            <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,4,0,0">
              <Grid>
                <TextBlock x:Name="ProgressLabel" Text="正在准备安装文件" FontSize="12" Foreground="#647184"/>
                <TextBlock x:Name="PercentLabel" Text="0%" FontSize="11" Foreground="#8A98AA" HorizontalAlignment="Right"/>
              </Grid>
              <Border Height="5" CornerRadius="3" Background="#ECF0F5" Margin="0,17,0,0">
                <Grid><Border x:Name="ProgressFill" Width="0" CornerRadius="3" HorizontalAlignment="Left" Background="#25282D"/></Grid>
              </Border>
              <TextBlock Text="装好后按 Ctrl+Alt+V，或把鼠标停在屏幕顶边，就能看到你的剪贴板。" FontSize="11" Foreground="#A0A8B4" Margin="0,18,0,0"/>
            </StackPanel>

            <Border x:Name="MessagePanel" Visibility="Collapsed" VerticalAlignment="Top" CornerRadius="13" Background="#F7F9FC" BorderBrush="#E8EDF4" BorderThickness="1" Padding="18,14">
              <StackPanel>
                <TextBlock x:Name="MessageTitle" FontSize="13" Foreground="#50627A"/>
                <TextBlock x:Name="MessageDetail" FontSize="11" Foreground="#8793A4" TextWrapping="Wrap" LineHeight="20" Margin="0,9,0,0"/>
              </StackPanel>
            </Border>
          </Grid>
        </Grid>

        <Border Grid.Row="2" BorderBrush="#EEF0F4" BorderThickness="0,1,0,0" Margin="0,7,0,0">
          <Grid Margin="32,0">
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="VersionLabel" Text="DUN" FontSize="11" Foreground="#8F9BA9"/>
              <TextBlock x:Name="AuthorLink" Text="by Sandun · github.com/sandun2027  ↗" FontSize="10" Foreground="#ADB5C0" Margin="0,5,0,0" Cursor="Hand"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Button x:Name="SecondaryButton" Content="返回" Visibility="Collapsed" Margin="0,0,8,0"/>
              <Button x:Name="PrimaryButton" Content="安装 DUN  →" IsDefault="True" Background="#25282D" Foreground="White" MinWidth="156" Height="43" Padding="21,10"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Viewbox>
  </Border>
</Window>
